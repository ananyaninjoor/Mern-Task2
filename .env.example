# Copy this file to ".env" and fill in your own values.

# If you have MongoDB installed locally, use this:
MONGO_URI=mongodb://127.0.0.1:27017/signupDB

# If you are using MongoDB Atlas (cloud, free tier), use a connection string
# that looks like this instead (replace with your own):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/signupDB

PORT=5000
